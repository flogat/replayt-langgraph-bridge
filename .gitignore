# Normative categories: docs/GITIGNORE_AND_LOCAL_ARTIFACTS.md §2–§3.
# Do not add broad globs (e.g. *.db, *.jsonl) without narrowing or check-ignore review;
# pyproject.toml, uv.lock, src/, tests/, docs/, .github/workflows/ must stay tracked (§3).

# E. Placeholder / mistaken paths (AI agents sometimes create these literally)
path/

# B. Orchestration and local agent scratch
.orchestrator/
.cursor/skills/
.aider*
alignment_result.json
.alignment_result.json

# A. Environment and secrets files
.env
.env.*
# If a tracked .env.example is added, insert the next line immediately below:
# !.env.example
.envrc
.direnv/
*.pem
*.p12
id_rsa
id_ed25519
*.key

# C. Local durable checkpoint / store dumps (dev-only; prefer dirs or *.dev.sqlite3 over *.db / *.jsonl)
local_checkpoints/
scratch/
*.dev.sqlite3

# D. Python / packaging / tooling
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
.venv/
venv/
